{
  "name": "@prjct.app/pi-answer",
  "version": "0.1.0",
    "description": "Pi extension: the agent ends every turn with a typed answer (change, answer, diagnosis, needs_input, blocked) instead of prose. Code stays in files; explanations only when asked.",
  "type": "module",
  "license": "MIT",
  "repository": {"type": "git", "url": "git+https://github.com/prjct-app/pi-answer.git"},
  "bugs": {"url": "https://github.com/prjct-app/pi-answer/issues"},
  "homepage": "https://github.com/prjct-app/pi-answer#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-agent",
    "pi-coding-agent",
    "pi-extension",
    "structured-output"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:pi": "node scripts/build-pi.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@prjct.app/pi-tui-kit": "^0.3.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.20.0",
    "typebox": "1.3.7",
    "typescript": "^5.9.3"
  }
}
